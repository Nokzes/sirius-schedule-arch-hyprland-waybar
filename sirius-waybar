#!/usr/bin/python3 -I
"""Модуль waybar: текущая пара группы Сириус колледжа, в подсказке — все пары на сегодня.

Протокол Livewire взят из https://github.com/PerovXP/pyrinium.
Сеть дёргается не чаще раза в REFRESH секунд, в остальное время — данные из кэша.
"""
import datetime as dt
import json
import os
import re
import sys
import time
from html import escape
from pathlib import Path

BASE = "https://schedule.siriusuniversity.ru"
REFRESH = 3 * 3600
CFG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "sirius-schedule" / "group"
DEFAULT_GROUP = "К0609-25/1"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "sirius-waybar.json"
SHORT_CFG = CFG.with_name("short")  # свои сокращения: «Полное название = Коротко» по строке

SHORT = {
    "Архитектура ИТ-систем и аппаратных средств": "Архитектура ИТ-систем",
    "Дискретная математика с элементами математической логики": "Дискретная математика",
    "Инженерная компьютерная графика": "Инженерная графика",
    "Иностранный язык в профессиональной деятельности": "Иностранный язык",
    "Операционные системы и среды": "ОС и среды",
    "Организация администрирования ИТ-систем": "Администрирование ИТ",
    "Основы проектирования баз данных": "Проектирование БД",
    "Основы работы с сетевыми операционными системами": "Сетевые ОС",
    "ПА продленное, Математика (Э)": "Пересдача: математика",
    "Приемопередающие устройства, линейные сооружения связи и источники электропитания": "Приёмопередающие устройства",
    "Программирование на языке Python": "Python",
    "Физическая культура": "Физкультура",
    "Элементы высшей математики": "Высшая математика",
}


def fetch_events(group):
    import http.cookiejar
    import urllib.request

    op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
    op.addheaders = [("User-Agent", "Mozilla/5.0")]
    html = op.open(BASE, timeout=15).read().decode()
    token = re.search(r"window.livewire_token = '([0-9A-Za-z]+)';", html)[1]
    init = json.loads(re.search(r'wire:initial-data="([^"]+)"', html)[1].replace("&quot;", '"'))
    body = json.dumps({
        "fingerprint": init["fingerprint"],
        "serverMemo": init["serverMemo"],
        "updates": [{"type": "callMethod", "payload": {"id": os.urandom(4).hex(), "method": "set", "params": [group]}}],
    }).encode()
    req = urllib.request.Request(BASE + "/livewire/message/main-grid", body, {
        "X-Livewire": "true", "X-Csrf-Token": token, "Content-Type": "application/json",
    })
    events = json.loads(op.open(req, timeout=15).read())["serverMemo"]["data"].get("events") or {}
    if isinstance(events, dict):
        out = []
        for key, items in events.items():
            for e in items if isinstance(items, list) else [items]:
                if isinstance(e, dict):
                    e.setdefault("_key", key)  # ключ может быть датой
                    out.append(e)
        return out
    return [e for e in events if isinstance(e, dict)]


def pick(e, *keys):
    for k in keys:
        v = e.get(k)
        if v not in (None, "", [], {}):
            return v
    return ""


def parse_date(s):
    s = str(s)
    if m := re.search(r"(\d{4})-(\d{2})-(\d{2})", s):
        return dt.date(int(m[1]), int(m[2]), int(m[3]))
    if m := re.search(r"(\d{2})\.(\d{2})\.(\d{4})", s):
        return dt.date(int(m[3]), int(m[2]), int(m[1]))
    return None


def short_fio(x):
    """«Лагаев Арсен Нурланович» → «Лагаев А. Н.»"""
    if x.get("last_name"):
        return " ".join([x["last_name"]] + [f"{x[k]}." for k in ("first_name_one", "middle_name_one") if x.get(k)])
    return x.get("fio") or x.get("name") or ""


def teachers(e):
    t = pick(e, "teachers", "teacher", "teacherFio", "fio")
    if isinstance(t, dict):
        t = list(t.values())
    if isinstance(t, list):
        t = ", ".join(short_fio(x) if isinstance(x, dict) else str(x) for x in t)
    return str(t)


def place(s):
    """«1.33К_2» → «К_2», «Альфа 5.13Альфа 5.13» → «Альфа 5.13»: убираем код аудитории."""
    s = str(s).strip()
    half = len(s) // 2
    if len(s) % 2 == 0 and s[:half] == s[half:]:
        s = s[:half]
    return re.sub(r"^[\d.,\-]+\s*", "", s) or s


def lesson(e):
    return {
        "start": str(pick(e, "startTime", "start_time", "timeStart", "start"))[:5],
        "end": str(pick(e, "endTime", "end_time", "timeEnd", "end"))[:5],
        "name": str(pick(e, "discipline", "name", "subject", "title")),
        "type": str(pick(e, "groupType", "lessonType", "lesson_type", "type")),
        "room": place(pick(e, "classroom", "auditory", "room")),
        "addr": str(pick(e, "address")),
        "teacher": teachers(e),
        "num": e.get("numberPair"),
    }


def today_lessons(events, day):
    res = [lesson(e) for e in events
           if (parse_date(pick(e, "date", "day")) or parse_date(e.get("_key", ""))) == day]
    return sorted(res, key=lambda x: x["start"])


def load_events(group):
    try:
        c = json.loads(CACHE.read_text())
        if c["group"] != group:
            c = None
    except Exception:
        c = None
    monday = (dt.date.today() - dt.timedelta(days=dt.date.today().weekday())).isoformat()
    fresh = c and c["week"] == monday and time.time() - c["ts"] < REFRESH
    if not fresh:
        try:
            c = {"group": group, "week": monday, "ts": time.time(), "events": fetch_events(group)}
            CACHE.parent.mkdir(parents=True, exist_ok=True)
            CACHE.write_text(json.dumps(c, ensure_ascii=False))
        except Exception as err:
            if not c or c["week"] != monday:  # кэш другой недели бесполезен
                raise err
    return c["events"]


def short_word(w):
    """«операционными» → «опер.»: обрезаем перед гласной, как в обычных сокращениях."""
    if len(w) <= 6 or not w.isalpha():
        return w
    i = 3
    while i < len(w) - 2 and w[i].lower() not in "аеёиоуыэюяaeiouy":
        i += 1
    return w[:i] + "."


def short_name(name):
    table = dict(SHORT)
    try:
        for line in SHORT_CFG.read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                table[k.strip()] = v.strip()
    except OSError:
        pass
    if name in table:
        return table[name]
    if len(name) <= 30:
        return name
    name = name.split(",")[0]
    return name if len(name) <= 30 else " ".join(short_word(w) for w in name.split())


def where(l):
    return ", ".join(x for x in (l["room"], l["addr"]) if x)


# цвета Catppuccin Macchiato
C_TEXT, C_SUB, C_DIM, C_GREEN, C_BLUE = "#cad3f5", "#a5adcb", "#6e738d", "#a6da95", "#8aadf4"
TYPES = {
    "Лекции": "Лекция",
    "Семинарские занятия": "Семинар",
    "Практические занятия": "Практика",
    "Лабораторные занятия": "Лабораторная",
    "Внеучебное мероприятие": "Мероприятие",
}
MONTHS = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля",
          "августа", "сентября", "октября", "ноября", "декабря"]
DAYS = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]


def plural(n, one, few, many):
    if n % 10 == 1 and n % 100 != 11:
        return one
    return few if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14 else many


def minutes_until(hhmm):
    h, m = map(int, hhmm.split(":"))
    now = dt.datetime.now()
    return h * 60 + m - now.hour * 60 - now.minute


def make_tooltip(group, items, cur, nxt, now):
    today = dt.date.today()
    n = len(items)
    rows = [
        f"<span size='large'><b>{DAYS[today.weekday()]}, {today.day} {MONTHS[today.month - 1]}</b></span>",
        f"<span color='{C_SUB}'>{escape(group)} · {n} {plural(n, 'пара', 'пары', 'пар')}</span>",
    ]
    for l in items:
        past = l["end"] <= now
        if l is cur:
            mark, color, note = "●", C_GREEN, "сейчас"
        elif l is nxt:
            mins = minutes_until(l["start"])
            mark, color = "○", C_BLUE
            note = f"через {mins // 60} ч {mins % 60} мин" if mins >= 60 else f"через {mins} мин"
        elif past:
            mark, color, note = "✓", C_DIM, ""
        else:
            mark, color, note = "○", C_DIM, ""
        num = f"{l['num']} пара" if l["num"] else ""
        info = " · ".join(x for x in (num, note) if x)
        meta = " · ".join(escape(x) for x in (TYPES.get(l["type"], l["type"]), l["room"], l["teacher"]) if x)
        name_color, meta_color = (C_DIM, C_DIM) if past else (C_TEXT, C_SUB)
        rows.append("")
        rows.append(f"<span color='{color}'>{mark}</span>  <span color='{name_color}'><b>{l['start']}–{l['end']}</b></span>"
                    + (f"  <span color='{color if note else C_DIM}'>{info}</span>" if info else ""))
        rows.append(f"   <span color='{name_color}'>{escape(l['name'])}</span>")
        if meta:
            rows.append(f"   <span size='small' color='{meta_color}'>{meta}</span>")
    return "\n".join(rows)


def out(text, tooltip="", cls=""):
    print(json.dumps({"text": text, "tooltip": tooltip, "class": cls}, ensure_ascii=False))


def main():
    group = (CFG.read_text().strip() if CFG.exists() else "") or DEFAULT_GROUP
    if not group:
        return out("группа?", f"Укажите группу в {CFG}", "error")
    try:
        items = today_lessons(load_events(group), dt.date.today())
    except Exception as e:
        return out("нет связи", escape(f"Не удалось загрузить расписание: {e}"), "error")

    if not items:
        return out("пар нет", f"{group}: сегодня пар нет", "free")

    now = dt.datetime.now().strftime("%H:%M")
    cur = next((l for l in items if l["start"] <= now < l["end"]), None)
    nxt = next((l for l in items if l["start"] > now), None)

    tooltip = make_tooltip(group, items, cur, nxt, now)

    if nxt:
        text, cls = f"{nxt['room'] or '—'} · {nxt['start']} · {short_name(nxt['name'])}", "next"
    else:
        text, cls = "пары закончились", "done"
    out(escape(text), tooltip, cls)


if __name__ == "__main__":
    if "--dump" in sys.argv:  # отладка: сырые события
        print(json.dumps(fetch_events((CFG.read_text().strip() if CFG.exists() else "") or DEFAULT_GROUP), ensure_ascii=False, indent=1))
    else:
        main()
